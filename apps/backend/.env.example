# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# MongoDB Atlas (rotate the Atlas password before using; never commit a real password)
MONGO_URI=mongodb+srv://USER:ROTATED_PASSWORD@cluster0.vyziw6y.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=devthriller

# DragonflyDB (Redis-wire compatible)
REDIS_URL=redis://localhost:6379

# JWT secrets (generate: openssl rand -hex 64)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dev-thriller
R2_PUBLIC_URL=

# CORS / frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Email (Resend default; set RESEND_API_KEY to enable)
EMAIL_FROM="Dev Thriller <no-reply@devthriller.app>"
RESEND_API_KEY=
